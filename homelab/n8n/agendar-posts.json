            }
          }
        }
      }
    },
    {
      "id": "9fbd769d-1b43-400a-be8d-c9c33acf3515",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Traduz a resposta do meta-publicar no que vai para a planilha.\nconst resp = $json;\nconst linha = $('Preparar').item.json.row_number;\nconst corpo = resp.body ?? {};\nlet status;\nlet resultado;\n\nif (resp.error) {\n  status = 'erro';\n  resultado = `Sem resposta do meta-publicar: ${resp.error.message ?? JSON.stringify(resp.error)}`;\n} else if (resp.statusCode === 200 || resp.statusCode === 207) {\n  const destinos = Object.entries(corpo);\n  resultado = destinos\n    .map(([destino, r]) => (r.ok ? `${destino}: ${r.url || r.id}` : `${destino}: ERRO ${r.erro}`))\n    .join('\\n');\n  const certos = destinos.filter(([, r]) => r.ok).length;\n  status = certos === destinos.length ? 'publicado' : certos > 0 ? 'parcial' : 'erro';\n} else {\n  status = 'erro';\n  resultado = `HTTP ${resp.statusCode}: ${corpo.erro ?? JSON.stringify(corpo)}`;\n}\n\nreturn {\n  json: {\n    row_number: linha,\n    status,\n    resultado,\n    publicado_em: status === 'erro' ? '' : DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm'),\n  },\n};\n"
      }
    },

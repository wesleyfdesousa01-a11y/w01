      },
      "parameters": {
        "method": "POST",
        "url": "http://meta-publicar:8787/publicar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Preparar').item.json.corpo) }}",
        "options": {
          "timeout": 600000,
          "response": {

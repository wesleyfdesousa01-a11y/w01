    {
      "id": "feeea2b0-8a1d-4144-8f39-3b53259cd5bd",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Escolhe as linhas cuja data_hora já chegou e monta o corpo para o meta-publicar.\n// Aceita data como 25/10/2026 18:00, 2026-10-25 18:00 ou o número serial do Sheets.\nconst ZONA = 'America/Sao_Paulo';\nconst FORMATOS = ['dd/MM/yyyy HH:mm:ss', 'dd/MM/yyyy HH:mm', 'yyyy-MM-dd HH:mm:ss', 'yyyy-MM-dd HH:mm'];\n\nfunction quando(valor) {\n  if (typeof valor === 'number') {\n    const utc = DateTime.fromMillis(Math.round((valor - 25569) * 86400000), { zone: 'UTC' });\n    return utc.setZone(ZONA, { keepLocalTime: true });\n  }\n  const texto = String(valor ?? '').trim();\n  for (const formato of FORMATOS) {\n    const d = DateTime.fromFormat(texto, formato, { zone: ZONA });\n    if (d.isValid) return d;\n  }\n  const iso = DateTime.fromISO(texto, { zone: ZONA });\n  return iso.isValid ? iso : null;\n}\n\nconst lista = (v) => String(v ?? '').split(/[\\n,;]+/).map((x) => x.trim()).filter(Boolean);\nconst agora = DateTime.now().setZone(ZONA);\nconst saida = [];\n\nfor (const item of $input.all()) {\n  const linha = item.json;\n  const data = quando(linha.data_hora);\n  if (!data) {\n    saida.push({ json: { row_number: linha.row_number, status: 'erro',\n      resultado: `data_hora inválida: \"${linha.data_hora}\". Use 25/10/2026 18:00`, publicado_em: '' } });\n    continue;\n  }\n  if (data > agora) continue; // ainda não é hora\n\n  const corpo = {\n    destinos: lista(linha.destinos).map((d) => d.toLowerCase()),\n    tipo: String(linha.tipo ?? '').trim().toLowerCase(),\n    texto: String(linha.texto ?? ''),\n    midias: lista(linha.midias),\n  };\n  if (String(linha.link ?? '').trim()) corpo.link = String(linha.link).trim();\n  saida.push({ json: { row_number: linha.row_number, status: 'publicando', corpo } });\n}\n\nreturn saida;\n"
      }
    },
